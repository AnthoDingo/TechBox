<Page
    x:Class="TechBox.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:TechBox.Helpers"
    xmlns:local="clr-namespace:TechBox.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
	xmlns:models="clr-namespace:TechBox.Models"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance local:SettingsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Page.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0.5*" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		
		<StackPanel Grid.Column="0" Visibility="Collapsed">
			<TextBlock
				FontSize="20"
				FontWeight="Medium"
				Text="Personalization" />
			<TextBlock Margin="0,12,0,0" Text="Theme" />
            <RadioButton
                Margin="0,12,0,0"
                Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
                CommandParameter="theme_system"
                Content="System"
                GroupName="themeSelect"
                IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Unknown, Mode=OneWay}"
                />
            <RadioButton
				Margin="0,12,0,0"
				Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
				CommandParameter="theme_light"
				Content="Light"
				GroupName="themeSelect"
				IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Light, Mode=OneWay}" />
			<RadioButton
				Margin="0,8,0,0"
				Command="{Binding ViewModel.ChangeThemeCommand, Mode=OneWay}"
				CommandParameter="theme_dark"
				Content="Dark"
				GroupName="themeSelect"
				IsChecked="{Binding ViewModel.CurrentTheme, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Dark, Mode=OneWay}" />

			<TextBlock
				Margin="0,24,0,0"
				FontSize="20"
				FontWeight="Medium"
				Text="About TechBox" />
			<TextBlock Margin="0,12,0,0" Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
		</StackPanel>

		<StackPanel Grid.Column="1">
			<Expander Header="SCCM Actions" MaxHeight="400">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ViewModel.SCCMActions}" Margin="8">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SCCMAction}">
                                <Border Margin="6"
                                    Padding="12"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Margin="0,0,0,4"/>
                                        <ui:ToggleSwitch  
                                            HorizontalAlignment="Right" 
                                            IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                            OffContent="Off" 
                                            OnContent="On">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="Checked">
                                                    <i:InvokeCommandAction Command="{Binding DataContext.ViewModel.SCCMActionToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}" />
                                                </i:EventTrigger>
                                                <i:EventTrigger EventName="Unchecked">
                                                    <i:InvokeCommandAction Command="{Binding DataContext.ViewModel.SCCMActionToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </ui:ToggleSwitch>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>
            </Expander>

            <ui:Card
                Margin="0,8,0,0"
                >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Grid.Column="0" Margin="0,7,0,0" Text="LDAP Path" />
                    <ui:TextBox Grid.Column="1" Margin="8,0,8,0" IsReadOnly="True"
                                Text="{Binding ViewModel.LdapPath, Mode=OneWay}" />
                    <ui:Button Grid.Column="2" HorizontalAlignment="Right" Content="Browse"
                               Icon="{ui:SymbolIcon Symbol=Search24}"
                               Command="{Binding ViewModel.BrowseLdapPathCommand}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBlock Grid.Column="0" Margin="0,7,0,0" Text="Backup Path" />
                    <ui:TextBox Grid.Column="1" Margin="8,0,8,0" Text="{Binding ViewModel.BackupPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="2" Margin="0,0,8,0" Content="Save" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Command="{Binding ViewModel.SaveBackupPathCommand}" />
                    <ui:Button Grid.Column="3" HorizontalAlignment="Right" Content="Browse" Icon="{ui:SymbolIcon Symbol=Search24}" Command="{Binding ViewModel.BrowseBackupPathCommand}" />
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <ui:TextBlock FontWeight="Medium" Text="Remote Admin Credentials" />
                    <TextBlock Margin="0,2,0,10" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Used to authenticate the current session against remote computers (e.g. opening an admin share $ in Explorer) when your own account isn't a local admin there. Password is encrypted for your Windows account on this machine." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBlock Grid.Row="0" Grid.Column="0" Margin="0,7,8,0" Text="Username" />
                        <ui:TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                            PlaceholderText="DOMAIN\adminuser"
                            Text="{Binding ViewModel.RemoteAdminUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:TextBlock Grid.Row="1" Grid.Column="0" Margin="0,7,8,0" Text="Password" />
                        <ui:PasswordBox Grid.Row="1" Grid.Column="1"
                            Password="{Binding ViewModel.RemoteAdminPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <ui:Button Margin="0,10,0,0" HorizontalAlignment="Right" Content="Save" Icon="{ui:SymbolIcon Symbol=Checkmark24}" Command="{Binding ViewModel.SaveRemoteAdminCredentialsCommand}" />
                </StackPanel>
            </ui:Card>
		</StackPanel>
	</Grid>
    
</Page>
