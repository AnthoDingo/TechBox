<Page 
    x:Class="TechBox.Views.Pages.Tools.ActiveDirectoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:TechBox.Views.Pages.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"   
    Title="ActiveDirectory"
    d:DataContext="{d:DesignInstance local:ActiveDirectoryPage,
                                 IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <ui:Button Content="Open Console" />
        </StackPanel>
        
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.33*" />
                <ColumnDefinition Width="0.33*" />
                <ColumnDefinition Width="0.33*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" VerticalAlignment="Stretch" Margin="5,0,0,0" VerticalContentAlignment="Top">
                <Grid>
                    <TextBlock Text="Computers" />
                    <ListView 
                        Margin="0,20,0,0"
                        ItemsSource="{Binding ViewModel.Computers}"
                        VerticalAlignment="Top"
                        MaxHeight="760"
                        >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="8,4" Text="{Binding}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="1" VerticalAlignment="Stretch" Margin="5,0,0,0" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Users" />
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Column="2" VerticalAlignment="Stretch" Margin="5,0,0,0" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Groups" />
                </StackPanel>
            </ui:Card>
        </Grid>
        

    </Grid>
</Page>
