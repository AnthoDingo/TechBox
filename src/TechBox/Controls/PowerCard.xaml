<UserControl x:Class="TechBox.Controls.PowerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TechBox.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="70" d:DesignWidth="600">

    <Border
        Width="380"
        Margin="0,10,10,0"
        Padding="15,10"
        Background="#3c3c3c"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Power20" FontSize="20" VerticalAlignment="Center" Cursor="Hand"
                               MouseLeftButtonUp="PowerIcon_MouseLeftButtonUp" />
                <Label Content="{Binding ComputerName, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=ComputerName}"
                       FontWeight="Medium" FontSize="16" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding UptimeText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" Margin="0,0,15,0" />

            <ui:Button Grid.Column="2" Icon="Dismiss16" Appearance="Transparent" Padding="4"
                       VerticalAlignment="Top" HorizontalAlignment="Right"
                       Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Border>
</UserControl>
