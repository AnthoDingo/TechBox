<UserControl
    x:Class="TechBox.Controls.PowerShellConsole"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Background="#FF0C0C0C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#FF1F1F1F">
            <TextBlock
                Margin="10,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Windows PowerShell 5.1" />
            <ui:Button
                Margin="10,4"
                Appearance="Transparent"
                Click="ClearButton_Click"
                Content="Effacer" />
            <ui:Button
                Margin="0,4"
                Appearance="Transparent"
                Click="RestartButton_Click"
                Content="Redémarrer" />
        </StackPanel>

        <TextBox
            x:Name="OutputBox"
            Grid.Row="1"
            Padding="8"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            Background="#FF0C0C0C"
            BorderThickness="0"
            FontFamily="Cascadia Mono, Consolas, Courier New"
            FontSize="13"
            Foreground="#FFCCCCCC"
            IsReadOnly="True"
            IsReadOnlyCaretVisible="False"
            IsUndoEnabled="False"
            TextWrapping="Wrap" />

        <Border
            Grid.Row="2"
            BorderBrush="#FF3F3F3F"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="8,0,4,0"
                    VerticalAlignment="Center"
                    FontFamily="Cascadia Mono, Consolas, Courier New"
                    Foreground="#FF4FC1E9"
                    Text="PS&gt;" />
                <TextBox
                    x:Name="InputBox"
                    Grid.Column="1"
                    Padding="0,8,8,8"
                    Background="Transparent"
                    BorderThickness="0"
                    CaretBrush="White"
                    FontFamily="Cascadia Mono, Consolas, Courier New"
                    FontSize="13"
                    Foreground="White"
                    KeyDown="InputBox_KeyDown" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
