<UserControl x:Class="TechBox.Controls.FolderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TechBox.Controls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="200">
    <Grid>
        <Border 
            Margin="0,10,10,0"
            Background="#3c3c3c"
            BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,1,1"
            CornerRadius="8,8,8,8"
            >
            <Grid Margin="15,15,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" 
                        Content="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=Folder}" 
                        IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=local:FolderCard}, Mode=TwoWay}" 
                        IsEnabled="{Binding IsCheckEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Checked="CheckBox_Checked"
                        Unchecked="CheckBox_Unchecked"
                        />

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Visibility="{Binding IsProgressVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" >
                        <Label Content="{Binding PercentComplete, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, FallbackValue=0}" />
                        <Label Content="%" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1" Margin="0,10,0,10" 
                    IsIndeterminate="{Binding IsProgressIndeterminate, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=True}" 
                    Visibility="{Binding IsProgressVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                    Minimum="0"
                    Maximum="100"
                    Value="{Binding PercentComplete, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                    />
            </Grid>
        </Border>
    </Grid>
</UserControl>
