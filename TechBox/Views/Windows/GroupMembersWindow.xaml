<ui:FluentWindow
    x:Class="TechBox.Views.Windows.GroupMembersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:TechBox.Views.Windows"
    xmlns:models="clr-namespace:TechBox.Models.ActiveDirectory"
    xmlns:helpers="clr-namespace:TechBox.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Membres du groupe"
    Height="480"
    Width="420"
    MinHeight="300"
    MinWidth="320"
    d:DataContext="{d:DesignInstance local:GroupMembersWindow,
                                 IsDesignTimeCreatable=False}"
    d:DesignHeight="480"
    d:DesignWidth="420"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="True"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibilityConverter" />
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"
                   Text="{Binding ViewModel.GroupName, StringFormat='Membres de {0}'}" />

        <ui:ProgressRing Grid.Row="1" IsIndeterminate="True" VerticalAlignment="Top"
                          Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <ListView Grid.Row="1"
                  ItemsSource="{Binding ViewModel.Members}"
                  Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource InvertBoolToVisibilityConverter}}">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:GroupMember}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{Binding Icon}" Margin="4,6" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <ui:TextBlock FontTypography="BodyStrong" Margin="8,4,8,0" Text="{Binding Name}" />
                            <ui:TextBlock Appearance="Secondary" Margin="8,0,0,4" Text="{Binding SamAccountName}"
                                          Visibility="{Binding SamAccountName, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#E81123" TextWrapping="Wrap"
                   Text="{Binding ViewModel.ErrorMessage}"
                   Visibility="{Binding ViewModel.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />
    </Grid>
</ui:FluentWindow>
