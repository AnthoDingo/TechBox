<ui:FluentWindow
    x:Class="TechBox.Views.Windows.PowerActionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:TechBox.Views.Windows"
    xmlns:helpers="clr-namespace:TechBox.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Power"
    Height="400"
    Width="380"
    MinHeight="400"
    MinWidth="380"
    d:DataContext="{d:DesignInstance local:PowerActionWindow,
                                 IsDesignTimeCreatable=False}"
    d:DesignHeight="400"
    d:DesignWidth="380"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <helpers:StringEqualsVisibilityConverter x:Key="StringEqualsVisibilityConverter" />
    </ui:FluentWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"
                   Text="{Binding ViewModel.ComputerName, StringFormat='Power - {0}'}" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Label Content="Action" Padding="0,0,0,4" />
            <ComboBox ItemsSource="{Binding ViewModel.Actions}" SelectedItem="{Binding ViewModel.SelectedAction}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <Label Content="Quand" Padding="0,0,0,4" />
            <ComboBox ItemsSource="{Binding ViewModel.Timings}" SelectedItem="{Binding ViewModel.SelectedTiming}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12"
                    Visibility="{Binding ViewModel.SelectedTiming, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter='Time remaining'}">
            <Label Content="Minutes restantes (1-30)" Padding="0,0,0,4" />
            <ui:TextBox Text="{Binding ViewModel.MinutesRemaining}" PreviewTextInput="MinutesTextBox_PreviewTextInput" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12"
                    Visibility="{Binding ViewModel.SelectedTiming, Converter={StaticResource StringEqualsVisibilityConverter}, ConverterParameter=Schedule}">
            <Label Content="Date et heure" Padding="0,0,0,4" />
            <DatePicker SelectedDate="{Binding ViewModel.ScheduledDate}"
                        DisplayDateStart="{Binding ViewModel.MinimumScheduledDate}" />
            <ui:TextBox Margin="0,8,0,0" Text="{Binding ViewModel.ScheduledTimeText}" PlaceholderText="HH:mm" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Annuler" Margin="0,0,8,0" Click="Cancel_Click" />
            <ui:Button Content="OK" Appearance="Primary" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
