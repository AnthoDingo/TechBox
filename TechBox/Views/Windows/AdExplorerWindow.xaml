<ui:FluentWindow
    x:Class="TechBox.Views.Windows.AdExplorerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:TechBox.Views.Windows"
    xmlns:models="clr-namespace:TechBox.Models.ActiveDirectory"
    xmlns:helpers="clr-namespace:TechBox.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Active Directory Explorer"
    Height="600"
    Width="900"
    d:DataContext="{d:DesignInstance local:AdExplorerWindow,
                                 IsDesignTimeCreatable=True}"
    d:DesignHeight="600"
    d:DesignWidth="900"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Grid.ColumnSpan="3">
            <ui:Button
                Content="Refresh"
                ToolTip="Refresh"
                Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                Command="{Binding ViewModel.RefreshCommand}" />
        </ToolBar>

        <!-- TreeView -->
        <TreeView Grid.Row="1" Grid.Column="0"
                  ItemsSource="{Binding ViewModel.Nodes}"
                  SelectedItemChanged="TreeView_SelectedItemChanged"
                  TreeViewItem.Expanded="TreeViewItem_Expanded"
                  Margin="4">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate
                    DataType="{x:Type models:AdTreeNode}"
                    ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="5" HorizontalAlignment="Stretch"/>

        <!-- Selected OU details -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="8">
            <StackPanel>
                <TextBlock Text="Détails" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <TextBlock Text="Nom" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ViewModel.SelectedNode.Name}" Margin="0,0,0,10"/>

                <TextBlock Text="Distinguished Name" FontWeight="SemiBold"/>
                <TextBox Text="{Binding ViewModel.SelectedNode.DistinguishedName, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Description" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ViewModel.SelectedNode.Description}" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="3">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="14"
                                 Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ViewModel.SelectedNode.DistinguishedName, StringFormat='{}DN : {0}'}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ViewModel.ErrorMessage}"
                           Foreground="#E81123" TextWrapping="Wrap" MaxWidth="500"
                           Visibility="{Binding ViewModel.HasError, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="8">
            <ui:Button x:Name="CancelButton" Content="Annuler" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <ui:Button Content="Sélectionner" Appearance="Primary"
                       IsEnabled="{Binding ViewModel.HasSelection}"
                       Click="SelectButton_Click"/>
        </StackPanel>

    </Grid>
</ui:FluentWindow>
