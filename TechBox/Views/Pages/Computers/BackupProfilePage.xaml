<Page 
    x:Class="TechBox.Views.Pages.Computers.BackupProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:TechBox.Views.Pages.Computers"
    xmlns:ctrls="clr-namespace:TechBox.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    Title="BackupProfilePage"
    d:DataContext="{d:DesignInstance local:BackupProfilePage,
                                IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="0.2*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:AutoSuggestBox 
                    HorizontalAlignment="Left" 
                    MinWidth="200" PlaceholderText="Computer Name" 
                    OriginalItemsSource="{Binding ViewModel.Computers, Mode=OneWay}"
                    SuggestionChosen="AutoSuggestBox_SuggestionChosen"
                />
                <ui:SymbolIcon Margin="25,0,0,0" Symbol="PersonAccounts20" FontSize="24"/>
                <ComboBox 
                    Margin="8,0,0,0" 
                    MinWidth="200"
                    ItemsSource="{Binding ViewModel.BackupProfiles, Mode=OneWay}"
                    SelectedItem="{Binding ViewModel.SelectedProfile}"
                    Name="cbxProfiles"
                 />
            </StackPanel>
            
            <ui:Button Grid.Column="1" 
                Content="{Binding ViewModel.ButtonText}" 
                Icon="Play20" 
                Appearance="{Binding ViewModel.ButtonApparence}" Height="35" 
                HorizontalAlignment="Right" Margin="0,0,0,0" 
                Command="{Binding ViewModel.RunCopyCommand}" />
        </Grid>
        
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.33*" />
                <ColumnDefinition Width="0.33*" />
                <ColumnDefinition Width="0.33*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <ui:TextBlock Text="User folders" FontSize="22" Margin="0,0,0,15"/>
                    <ui:VirtualizingItemsControl ItemsSource="{Binding ViewModel.UserFolders}" >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ctrls:FolderCard }">
                                <ctrls:FolderCard Title="{Binding Title}" IsChecked="{Binding IsChecked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ui:VirtualizingItemsControl>

                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Column="1" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <ui:TextBlock Text="Local AppData" FontSize="22" Margin="0,0,0,15" />
                    <ui:VirtualizingItemsControl ItemsSource="{Binding ViewModel.LocalAppData}" >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type CheckBox }">
                                <CheckBox Content="{Binding Content}" IsChecked="{Binding IsChecked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ui:VirtualizingItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <ui:TextBlock Text="Roaming AppData" FontSize="22" Margin="0,0,0,15" />
                    <ui:VirtualizingItemsControl ItemsSource="{Binding ViewModel.RoamingAppData}" >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type CheckBox }">
                                <CheckBox Content="{Binding Content}" IsChecked="{Binding IsChecked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ui:VirtualizingItemsControl>
                </StackPanel>
            </ui:Card>
        </Grid>

        <!--<Grid Grid.Row="2" Margin="0,15,0,0">
            <StackPanel>
                <ui:VirtualizingItemsControl ItemsSource="{Binding ViewModel.UserFolders}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type ctrls:FolderCard }">
                            <ctrls:FolderCard Title="{Binding Title}" Visibility="{Binding IsVisible}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ui:VirtualizingItemsControl>
                
                
                
            </StackPanel>
        </Grid>-->
        
    </Grid>
</Page>
