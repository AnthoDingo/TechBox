<Page 
    x:Class="TechBox.Views.Pages.Users.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:TechBox.Views.Pages.Users"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:TechBox.Helpers"
    xmlns:autohelpers="clr-namespace:TechBox.Helpers.AutoSuggestBox"
    xmlns:models="clr-namespace:TechBox.Models.ActiveDirectory"
    Title="UserInfoPage"
    d:DataContext="{d:DesignInstance local:InfoPage,
                                 IsDesignTimeCreatable=False}"
    d:DesignHeight="950"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibilityConverter" />
        <helpers:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <autohelpers:SuggestionChosenToString x:Key="SuggestionChosenToString" />
        <autohelpers:QuerySubmittedToString x:Key="QuerySubmittedToString" />
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="DarkRed" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="DarkRed" />
        <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="DarkGreen" />
        <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="DarkGreen" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:AutoSuggestBox HorizontalAlignment="Left" MinWidth="200" Grid.Row="0" PlaceholderText="User"
            OriginalItemsSource="{Binding ViewModel.Users, Mode=OneWay}"
            QuerySubmitted="AutoSuggestBox_QuerySubmitted"
            SuggestionChosen="AutoSuggestBox_SuggestionChosen"/>

        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="User infos" FontSize="20" />
                    <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding ViewModel.SearchingInfos, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Grid Visibility="{Binding ViewModel.SearchingInfos, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.5*"/>
                            <ColumnDefinition Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Label Content="UserName" Target="{Binding ElementName=UserName}" Margin="0,10,0,0"/>
                            <TextBox x:Name="UserName" Text="{Binding ViewModel.SelectedUser.samAccountName, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,0">
                            <Label Content="FullName" Target="{Binding ElementName=FullName}" Margin="0,10,0,0"/>
                            <TextBox x:Name="FullName" Text="{Binding ViewModel.SelectedUser.FullName, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5,0,0">
                            <Label Content="GecosID" Target="{Binding ElementName=GecosID}" Margin="0,10,0,0"/>
                            <TextBox x:Name="GecosID" Text="{Binding ViewModel.SelectedUser.GecosID, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" VerticalAlignment="Center" >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*" />
                                    <ColumnDefinition Width="0.5*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,30,0,0" HorizontalAlignment="Center">
                                    <ui:ToggleSwitch x:Name="isLocked" IsEnabled="False" IsChecked="{Binding ViewModel.SelectedUser.IsLocked, Mode=OneWay}" >

                                    </ui:ToggleSwitch>
                                    <TextBlock Text="{Binding ViewModel.IsLockedString, FallbackValue='Unlocked'}" Margin="5,0,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,30,0,0" HorizontalAlignment="Center">
                                    <ui:ToggleSwitch IsEnabled="False" IsChecked="{Binding ViewModel.SelectedUser.IsDisabled, Mode=OneWay}" />
                                    <TextBlock Text="{Binding ViewModel.IsDisabledString, FallbackValue='Enabled'}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0">

                            <Label Content="SID" Target="{Binding ElementName=SSID}" Margin="0,10,0,0"/>
                            <TextBox x:Name="SID" Text="{Binding ViewModel.SelectedUser.SID, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,20,0,10">
                            <Separator  Height="1"  />
                        </StackPanel>


                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <Label Content="Description" Target="{Binding ElementName=Description}" Margin="0,10,0,0"/>
                            <TextBox x:Name="Description" Text="{Binding ViewModel.SelectedUser.Description, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="5,0,0,0">
                            <Label Content="Mail" Target="{Binding ElementName=Mail}" Margin="0,10,0,0"/>
                            <TextBox x:Name="Mail" Text="{Binding ViewModel.SelectedUser.Mail, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,5,0,0">
                            <Label Content="Phone" Target="{Binding ElementName=Phone}" Margin="0,10,0,0"/>
                            <TextBox x:Name="Phone" Text="{Binding ViewModel.SelectedUser.Phone, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="5,5,0,0">
                            <Label Content="Mobile" Target="{Binding ElementName=Mobile}" Margin="0,10,0,0"/>
                            <TextBox x:Name="Mobile" Text="{Binding ViewModel.SelectedUser.Mobile, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,20,0,10">
                            <Separator  Height="1"  />
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2">
                            <Label Content="Home Directory" Target="{Binding ElementName=HomeDirectory}" Margin="0,10,0,0"/>
                            <TextBox x:Name="HomeDirectory" Text="{Binding ViewModel.SelectedUser.HomeDirectory, Mode=OneWay}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="8" Grid.Column="0" Margin="0,5,0,0">
                            <Label Content="Last Logon (yyyy/MM:dd)" Target="{Binding ElementName=LastLogon}" Margin="0,10,0,0"/>
                            <TextBox x:Name="LastLogon" Text="{Binding ViewModel.SelectedUser.LastLogon, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="8" Grid.Column="1" Margin="5,5,0,0">
                            <Label Content="Account Expire (yyyy/MM:dd)" Target="{Binding ElementName=AccountExpire}" Margin="0,10,0,0"/>
                            <TextBox x:Name="AccountExpire" Text="{Binding ViewModel.SelectedUser.AccountExpire, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="9" Grid.Column="0" Margin="0,5,0,0">
                            <Label Content="Password Set (yyyy/MM:dd)" Target="{Binding ElementName=PasswordSet}" Margin="0,10,0,0"/>
                            <TextBox x:Name="PasswordSet" Text="{Binding ViewModel.SelectedUser.PasswordSet, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}" IsReadOnly="True" />
                        </StackPanel>

                        <StackPanel Grid.Row="9" Grid.Column="1" Margin="5,5,0,0">
                            <Label Content="Password Expire (yyyy/MM:dd)" Target="{Binding ElementName=PasswordExpire}" Margin="0,10,0,0"/>
                            <TextBox x:Name="PasswordExpire" Text="{Binding ViewModel.SelectedUser.PasswordExpire, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}}" IsReadOnly="True" />
                        </StackPanel>

                    </Grid>

                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Column="1" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Margin="0,0,0,15">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="MemberOf" FontSize="20" />

                        <ui:TextBox 
                            Grid.Column="1"
                            MinWidth="200" MaxWidth="200"
                            HorizontalAlignment="Right" 
                            PlaceholderText="Search"
                            Text="{Binding ViewModel.MemberOfSearch, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            IsEnabled="{Binding ViewModel.SearchingMemberOfInverted}"                            
                            />
                    </Grid>
                    
                    <ui:ProgressRing IsIndeterminate="True" Visibility="{Binding ViewModel.SearchingMemberOf, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ListView
                        Margin="0,10,0,0"
                        VerticalAlignment="Stretch" 
                        MaxHeight="760" 
                        ItemsSource="{Binding ViewModel.MemberOf, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding ViewModel.SearchingMemberOf, Converter={StaticResource InvertBoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Group}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:InfoBadge 
                                        Margin="10" 
                                        CornerRadius="30"
                                        Icon="{Binding Icon}"
                                        Severity="Informational"
                                        Style="{DynamicResource IconInfoBadgeStyle}"
                                        />
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:TextBlock FontTypography="BodyStrong" Margin="8,4" Text="{Binding Name}" />
                                        <ui:TextBlock Appearance="Secondary" Margin="8,0,0,0" Text="{Binding Email}" Visibility="{Binding Email, Converter={StaticResource StringToVisibilityConverter}}" />
                                    </StackPanel>

                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</Page>